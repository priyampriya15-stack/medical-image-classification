# ==============================================================================
# Backend Environment Configuration (Example)
# ==============================================================================

# Application Metadata
APP_NAME="Medical Image Classification API"
APP_VERSION="1.0.0"
API_PREFIX="/api"

# Server Host & Dynamic Port (Render injects $PORT automatically)
HOST="0.0.0.0"
PORT=8001

# Allowed CORS Origins (Comma-separated for multiple origins)
# Local: "http://localhost:5173,http://localhost:5174,http://localhost:5175"
# Vercel Production: "https://<your-vercel-app>.vercel.app"
# Render Production: "https://<your-render-frontend>.onrender.com"
FRONTEND_ORIGIN="http://localhost:5173"

# Filesystem Storage Directories (Relative to backend/ or absolute)
DATA_DIR="data"
CHECKPOINT_DIR="checkpoints"
OUTPUT_DIR="outputs"

# Device Execution Target ("cpu" or "cuda" - leave empty for auto-detection)
DEVICE="cpu"
