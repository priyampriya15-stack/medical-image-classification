*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/

# Node.js dependencies & Vite builds
node_modules/
dist/
build/
.vite/
.npm/
frontend/dist/
frontend/frontend/

# Environment configurations (Keep examples only)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
backend/.env
!.env.example
!frontend/.env.example
!backend/.env.example

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor configurations
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary and scratch files
scratch/
tmp/
temp/
